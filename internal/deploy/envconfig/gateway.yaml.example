# The Digizoo default gateway YAML for a polypus deploy environment. polypus deploy init
# writes it beside the environment's config.yaml; edit it there.
#
# It runs on OpenRouter alone, with the work OpenRouter key: polypus deploy injects
# OPENROUTER_API_KEY through the compose environment, from the environment's keyring
# service (polypus-<identifier>); store it with polypus deploy secret set OPENROUTER_API_KEY.
# Do NOT add a secrets: block here; the gateway container has no host OS keyring.
#
# Claude direct on the Team plan's credits (claude_team) is below, commented out. A backend
# in this file makes its key required on every deploy, so turn it on only once you have a
# Console key: see "Turning Claude on" under backends.

processes:
  mlx: false

chat_backend:
  enabled: true
  default: openrouter
vision_backend:
  enabled: true
  default: openrouter
embed_backend:
  enabled: true
  default: openrouter
# No proxy_backend: it serves voice listings (/v1/audio/voices), which OpenRouter does not.
tts_backend:
  enabled: true
  default: openrouter
stt_backend:
  enabled: true
  default: openrouter
systemone_backend:
  enabled: true
  default: openrouter
# /v1/batches on OpenRouter's Batch API: only models with a :batch variant on OpenRouter
# accept batches (both chat models below do; openai/gpt-oss-20b is the cheapest).
batch_backend:
  enabled: true
  default: openrouter

timeouts:
  min: 5s
  max: 900s
  chat: 120s
  chat_thinking: 600s
  vision: 300s
  embed: 15s
  speech: 180s

switchyard:
  base_url: http://switchyard:4000
  config_path: /var/lib/polypus/switchyard/routes.toml

backends:
  openrouter:
    remote: true
    base_url: https://openrouter.ai/api/v1
    auth:
      bearer_env: OPENROUTER_API_KEY
    capabilities: [chat, vision, embed, tts, stt, systemone, batch]
    models:
      sync: true
      allow:
        - anthropic/claude-sonnet-5.5
        - anthropic/claude-haiku-5.5
        - google/gemini-2.5-flash
        - openai/gpt-oss-20b
        - baai/bge-m3
        - hexgrad/kokoro-82m
        - fish-audio/transcribe-1-pro
      systemone_allow:
        - perplexity/pplx-decider-v1.2

  # Turning Claude on, once you have a Console key from the Team plan's organisation:
  #   1. Uncomment claude_team below.
  #   2. Store the key: polypus deploy secret set ANTHROPIC_API_KEY
  #   3. Set batch_backend.default to claude_team, and add batch to its capabilities.
  #   4. Swap router/turno to the fallback route at the end of this file.
  # claude_team:
  #   remote: true
  #   extension: anthropic
  #   auth:
  #     bearer_env: ANTHROPIC_API_KEY
  #   capabilities: [chat, vision]
  #   models:
  #     sync: true
  #     allow:
  #       - claude-sonnet-5-5
  #       - claude-haiku-5-5

# Named routers (public model ids: router/<name>). turno-acp calls router/turno.
routers:
  turno:
    capability: chat
    route:
      type: passthrough
      target: openrouter/anthropic/claude-sonnet-5.5
      # With claude_team on, Claude first and the same model on OpenRouter when Claude
      # is unavailable (5xx, timeout, out of credit or overloaded):
      # type: fallback
      # targets:
      #   - claude_team/claude-sonnet-5-5
      #   - openrouter/anthropic/claude-sonnet-5.5
