# syntax=docker/dockerfile:1
# Runtime image: COPY pre-built linux/amd64 switchyard-server from GitHub Release assets.

# switchyard-server is built on ubuntu-latest (glibc 2.38+); bookworm is too old.
FROM debian:trixie-slim

ARG APP_VERSION=
ARG GIT_REVISION=
ARG BUILD_CREATED=
ARG REBUILD_REVISION=
ARG BASE_IMAGE=
ARG BASE_DIGEST=

LABEL org.opencontainers.image.title="polypus-switchyard" \
      org.opencontainers.image.description="Polypus switchyard routing sidecar" \
      org.opencontainers.image.url="https://github.com/behaviorengineering/polypus" \
      org.opencontainers.image.source="https://github.com/behaviorengineering/polypus" \
      org.opencontainers.image.documentation="https://github.com/behaviorengineering/polypus#readme" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.opencontainers.image.vendor="behaviorengineering" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      com.behaviorengineering.image.rebuild-revision="${REBUILD_REVISION}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY docker-bin/switchyard-server /usr/local/bin/switchyard-server
COPY scripts/docker-switchyard-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/switchyard-server

ENV SWITCHYARD_CONFIG=/var/lib/polypus/switchyard/routes.toml
ENV SWITCHYARD_HOST=0.0.0.0
ENV SWITCHYARD_PORT=4000

EXPOSE 4000

HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=6 \
  CMD curl -sf http://127.0.0.1:4000/health || exit 1

ENTRYPOINT ["/bin/sh", "/usr/local/bin/entrypoint.sh"]
