# Polypus multi-backend router.
# Copy to ~/.config/polypus/config.yaml (or set POLYPUS_CONFIG).
# Env-only single backend works without this file (mlx_local from POLYPUS_MLX_*).

# Process-compose toggles (pc-up.sh). POLYPUS_ENABLE_MLX overrides when set.
processes:
  mlx: true

default_tts_backend: mlx_local
default_stt_backend: mlx_local
default_proxy_backend: mlx_local

backends:
  mlx_local:
    base_url: http://127.0.0.1:1322
    capabilities: [tts, stt, voices]
    # Optional: gate speech models (leave omit for open)
    # models:
    #   allow:
    #     - mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16

# Optional LM Studio (local chat / vision / OCR / embeddings):
# default_chat_backend: lm_studio
# default_vision_backend: lm_studio
# default_embed_backend: lm_studio
# lm_studio:
#   base_url: http://127.0.0.1:1234/v1
#   capabilities: [chat, vision, embed]
#   models:
#     sync: true
#     allow:
#       - allenai/olmocr-2-7b
#       - text-embedding-nomic-embed-text-v1.5

# Optional Cloudflare in-process extension (INFERENCE_CLOUD_CASE=1):
# cf_local:
#   remote: true
#   extension: cloudflare
#   base_url: https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1
#   auth:
#     bearer_env: CF_AI_API_KEY
#   capabilities: [chat, vision, tts, stt, voices]
#   models:
#     sync: true
#     allow:
#       - "@cf/zai-org/glm-4.7-flash"
# Use config.cloud.yaml.example for cloud-default routing.

# Case-mode breach guardrails (defaults match omission of this block).
# policy:
#   reject_non_loopback_backends: true
#   require_cloud_opt_in: true

# Hop timeouts (optional). Omitted keys use code defaults.
# Client header X-Polypus-Timeout (e.g. 600s) is clamped to min..max.
# timeouts:
#   min: 5s
#   max: 900s
#   chat: 120s
#   chat_thinking: 600s
#   vision: 300s
#   embed: 60s
#   speech: 180s
#   backends:
#     cf_local:
#       chat: 60s

# Model routing: backend_id/downstream-model
# Example chat: model=cf_local/@cf/zai-org/glm-4.7-flash
# Example STT: model=alt_stt/whisper-large-v3
#
# GET /v1/models          → enabled models only (models.allow when set)
# GET /v1/models?view=inventory → full upstream inventory

# Optional Switchyard (always-on when using composed routers):
# switchyard:
#   base_url: http://127.0.0.1:4000
#   config_path: ~/.cache/polypus/switchyard/routes.toml  # generated at startup

# Named routers (public model ids: router/<name>):
